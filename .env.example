# ─────────────────────────────────────────────────────────────────
# Docker Compose Environment Variables
# Copy this file to .env and customise before running docker compose.
# docker-compose.yml reads .env automatically. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# Django shared — generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Backend REST API (used by frontend-admin) — http://localhost:8020
BACKEND_PORT=8020

# Django Web App (HTMX templates) — http://localhost:8000
DJANGO_PORT=8000

# Frontend Admin (React SPA) — http://localhost:5173
ADMIN_PORT=5173
VITE_API_BASE_URL=/api/v1

# ── Production-only (used by config.settings.prod / django_app when
#    DJANGO_SETTINGS_MODULE / DJANGO_DEBUG are switched to prod mode —
#    see docments/Deployment_Guide.md) ────────────────────────────────
# DJANGO_ALLOWED_HOSTS=your-domain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# DJANGO_DEBUG=false
