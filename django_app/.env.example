# Copy to .env and adjust before running docker compose up
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=shipment_sourcing
POSTGRES_USER=shipment_sourcing
POSTGRES_PASSWORD=change-this-password

WEB_PORT=8000

# Set to true to populate demo users/data on first boot (safe to leave true; it's idempotent)
DJANGO_SEED_DATA=true
